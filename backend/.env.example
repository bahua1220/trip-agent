
# LLM配置（LangChain ChatOpenAI；填写自己的服务配置）
# 模型名称
LLM_MODEL_ID=your-model-name
LLM_THINKING_ENABLED=false
LLM_JSON_MODE_ENABLED=true
LLM_TIMEOUT=120
LLM_SDK_MAX_RETRIES=1
LLM_PLANNER_MAX_ATTEMPTS=2
LLM_RETRY_BASE_DELAY=2

# 可选：主模型持续返回 429/5xx 时切换；不配置则保持禁用
LLM_FALLBACK_MODEL_ID=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_THINKING_ENABLED=false

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# MySQL（生产环境建议使用专用账号，不使用 root）
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trip_agent
MYSQL_USER=trip_agent
MYSQL_PASSWORD=replace-with-a-strong-password
AUTH_SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
TRIP_DAILY_GENERATION_LIMIT=10
TRIP_TASK_RETENTION_HOURS=24

# 微信小程序登录。AppSecret 只能放在后端环境变量中，不能写入 Web 或小程序代码。
WECHAT_APP_ID=wx_your_mini_program_app_id
WECHAT_APP_SECRET=replace-with-your-mini-program-app-secret
WECHAT_CONTENT_SECURITY_ENABLED=true

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# 可选：公开信息补充与异常跨城耗时查询；会消耗供应商额度
TAVILY_API_KEY=
